# ================= DATABASE =================

def db_connect():

    conn = sqlite3.connect(
        DB_PATH,
        timeout=30
    )

    conn.row_factory = sqlite3.Row

    return conn


def init_database():

    with db_lock:

        conn = db_connect()

        conn.execute("""
            CREATE TABLE IF NOT EXISTS history (
                period TEXT PRIMARY KEY,
                number INTEGER NOT NULL,
                big_small TEXT NOT NULL,
                color TEXT NOT NULL,
                broadcasted INTEGER DEFAULT 0,
                created_at TEXT DEFAULT CURRENT_TIMESTAMP
            )
        """)

        # Enable WAL for safer concurrent database access
        conn.execute("PRAGMA journal_mode=WAL")

        conn.commit()
        conn.close()

    log.info("Database initialized")


# ================= RESULT PROCESSOR =================

def get_color(number):

    mapping = {
        0: ["Red", "Violet"],
        1: ["Green"],
        2: ["Red"],
        3: ["Green"],
        4: ["Red"],
        5: ["Green", "Violet"],
        6: ["Red"],
        7: ["Green"],
        8: ["Red"],
        9: ["Green"]
    }

    return mapping[number]


def extract_api_list(data):

    if isinstance(data, dict):

        if isinstance(data.get("data"), dict):

            result = data["data"].get("list")

            if isinstance(result, list):
                return result

        if isinstance(data.get("data"), list):
            return data["data"]

        if isinstance(data.get("list"), list):
            return data["list"]

        if isinstance(data.get("result"), list):
            return data["result"]

    if isinstance(data, list):
        return data

    return []


def normalize_result(item):

    if not isinstance(item, dict):
        return None

    period = (
        item.get("issueNumber")
        or item.get("issue")
        or item.get("period")
    )

    number = item.get("number")

    if period is None or number is None:
        return None

    period = str(period).strip()

    try:

        number = int(number)

    except (ValueError, TypeError):

        return None

    if not period or number < 0 or number > 9:
        return None

    big_small = "Big" if number >= 5 else "Small"

    raw_color = item.get("color")

    if isinstance(raw_color, list) and raw_color:

        color = [
            str(x).strip().capitalize()
            for x in raw_color
        ]

    elif isinstance(raw_color, str) and raw_color.strip():

        color = [
            x.strip().capitalize()
            for x in raw_color.replace(",", " ").split()
        ]

    else:

        color = get_color(number)

    allowed_colors = {
        "Red",
        "Green",
        "Violet"
    }

    if (
        not color
        or any(x not in allowed_colors for x in color)
    ):
        return None

    return {
        "period": period,
        "number": number,
        "big_small": big_small,
        "color": color
    }


# ================= FETCH GAME API =================

def fetch_game_data():

    request = urllib.request.Request(
        API_URL,
        headers=HEADERS
    )

    with urllib.request.urlopen(
        request,
        timeout=15
    ) as response:

        if response.status != 200:

            raise RuntimeError(
                f"Game API HTTP {response.status}"
            )

        raw = response.read().decode("utf-8")

        data = json.loads(raw)

    raw_list = extract_api_list(data)

    results = []

    for item in raw_list:

        record = normalize_result(item)

        if record:
            results.append(record)

    # Chronological order
    results.sort(
        key=lambda x: x["period"]
    )

    return results


# ================= DATABASE OPERATIONS =================

def database_is_empty():

    with db_lock:

        conn = db_connect()

        row = conn.execute(
            "SELECT COUNT(*) AS total FROM history"
        ).fetchone()

        conn.close()

    return row["total"] == 0


def save_result(record, broadcasted=0):

    with db_lock:

        conn = db_connect()

        try:

            cursor = conn.execute("""
                INSERT OR IGNORE INTO history
                (
                    period,
                    number,
                    big_small,
                    color,
                    broadcasted
                )
                VALUES (?, ?, ?, ?, ?)
            """, (
                record["period"],
                record["number"],
                record["big_small"],
                json.dumps(record["color"]),
                broadcasted
            ))

            inserted = cursor.rowcount == 1

            conn.commit()

            return inserted

        finally:

            conn.close()


def seed_initial_history(results):

    count = 0

    for record in results:

        if save_result(record, broadcasted=1):
            count += 1

    log.info(
        "Initial history saved: %s records",
        count
    )


def get_pending_results():

    with db_lock:

        conn = db_connect()

        rows = conn.execute("""
            SELECT
                period,
                number,
                big_small,
                color
            FROM history
            WHERE broadcasted = 0
            ORDER BY period ASC
        """).fetchall()

        conn.close()

    return [
        {
            "period": row["period"],
            "number": row["number"],
            "big_small": row["big_small"],
            "color": json.loads(row["color"])
        }
        for row in rows
    ]


def mark_broadcasted(periods):

    if not periods:
        return

    with db_lock:

        conn = db_connect()

        try:

            conn.executemany("""
                UPDATE history
                SET broadcasted = 1
                WHERE period = ?
            """, [
                (period,)
                for period in periods
            ])

            conn.commit()

        finally:

            conn.close()


def get_history(limit=100):

    limit = max(
        1,
        min(int(limit), MAX_HISTORY)
    )

    with db_lock:

        conn = db_connect()

        rows = conn.execute("""
            SELECT
                period,
                number,
                big_small,
                color
            FROM history
            ORDER BY period DESC
            LIMIT ?
        """, (limit,)).fetchall()

        conn.close()

    return [
        {
            "period": row["period"],
            "number": row["number"],
            "big_small": row["big_small"],
            "color": json.loads(row["color"])
        }
        for row in rows
    ]


def cleanup_old_history():

    with db_lock:

        conn = db_connect()

        try:

            conn.execute("""
                DELETE FROM history
                WHERE broadcasted = 1
                AND period IN (
                    SELECT period
                    FROM history
                    WHERE broadcasted = 1
                    ORDER BY period DESC
                    LIMIT -1 OFFSET ?
                )
            """, (MAX_HISTORY,))

            conn.commit()

        finally:

            conn.close()


# ================= JSON BATCH BUILDER =================

def build_batches(records):

    batches = []

    current = []

    for record in records:

        candidate = current + [record]

        candidate_json = json.dumps(
            candidate,
            ensure_ascii=False,
            indent=2
        )

        if (
            len(candidate_json) > MAX_MESSAGE_CHARS
            and current
        ):

            batches.append(current)

            current = [record]

        else:

            current = candidate

    if current:
        batches.append(current)

    return batches


# ================= TELEGRAM SENDER =================

def telegram_send(records):

    if not BOT_TOKEN:

        log.error("Bot token missing")

        return False

    # Multiple records in ONE JSON array
    message = json.dumps(
        records,
        ensure_ascii=False,
        indent=2
    )

    if len(message) > MAX_MESSAGE_CHARS:

        log.error(
            "Message exceeds safe character limit"
        )

        return False

    payload = {
        "chat_id": CHANNEL_ID,
        "text": message
    }

    url = (
        f"https://api.telegram.org/bot"
        f"{BOT_TOKEN}/sendMessage"
    )

    body = urllib.parse.urlencode(
        payload
    ).encode()

    request = urllib.request.Request(
        url,
        data=body,
        headers={
            "Content-Type": "application/x-www-form-urlencoded"
        },
        method="POST"
    )

    try:

        with urllib.request.urlopen(
            request,
            timeout=20
        ) as response:

            result = json.loads(
                response.read().decode("utf-8")
            )

        if result.get("ok") is True:

            log.info(
                "MESSAGE SENT | Results: %s | Characters: %s",
                len(records),
                len(message)
            )

            return True

        log.error(
            "Telegram error: %s",
            result
        )

    except Exception as error:

        log.error(
            "Telegram send failed: %s",
            error
        )

    return False


# ================= AUTO BATCH PROCESSOR =================

def process_pending(force=False):

    global pending_started

    pending = get_pending_results()

    if not pending:

        pending_started = None

        return

    if pending_started is None:

        pending_started = time.monotonic()

    batches = build_batches(pending)

    # The first batch is ready when its size approaches limit.
    first_batch_json = json.dumps(
        batches[0],
        ensure_ascii=False,
        indent=2
    )

    size_full = (
        len(first_batch_json) >= MAX_MESSAGE_CHARS - 100
    )

    # If several batches are already required,
    # send them in sequence.
    multiple_batches = len(batches) > 1

    elapsed = (
        time.monotonic() - pending_started
    )

    timer_expired = (
        elapsed >= BATCH_MAX_WAIT
    )

    if not (
        force
        or size_full
        or multiple_batches
        or timer_expired
    ):

        log.debug(
            "Collecting results: %s records, %s seconds",
            len(pending),
            int(elapsed)
        )

        return

    log.info(
        "BATCH READY | Records: %s | Messages: %s",
        len(pending),
        len(batches)
    )

    for index, batch in enumerate(batches, start=1):

        success = telegram_send(batch)

        if not success:

            log.warning(
                "Batch %s failed. Pending data retained.",
                index
            )

            pending_started = time.monotonic()

            return

        periods = [
            item["period"]
            for item in batch
        ]

        mark_broadcasted(periods)

        log.info(
            "Batch %s/%s confirmed",
            index,
            len(batches)
        )

    pending_started = None

    cleanup_old_history()

    log.info("All pending batches processed")


# ================= DATA COLLECTOR =================

def collector_loop():

    initialized = not database_is_empty()

    log.info("Collector started")

    while True:

        try:

            results = fetch_game_data()

            if not results:

                log.warning(
                    "API returned no valid results"
                )

            elif not initialized:

                # First startup: save existing records,
                # do not send historical records.
                seed_initial_history(results)

                initialized = True

            else:

                new_count = 0

                for record in results:

                    if save_result(
                        record,
                        broadcasted=0
                    ):

                        new_count += 1

                if new_count:

                    log.info(
                        "New unique records: %s",
                        new_count
                    )

            # Process pending results on every cycle.
            process_pending()

            time.sleep(
                max(0.5, POLL_INTERVAL)
            )

        except Exception:

            log.exception(
                "Collector error"
            )

            time.sleep(
                max(POLL_INTERVAL, 3)
            )


# ================= WEBSITE JSON API =================

class WebsiteHandler(BaseHTTPRequestHandler):

    def send_json(self, data, status=200):

        content = json.dumps(
            data,
            ensure_ascii=False,
            indent=2
        ).encode("utf-8")

        self.send_response(status)

        self.send_header(
            "Content-Type",
            "application/json; charset=utf-8"
        )

        self.send_header(
            "Access-Control-Allow-Origin",
            "*"
        )

        self.send_header(
            "Access-Control-Allow-Methods",
            "GET, OPTIONS"
        )

        self.send_header(
            "Access-Control-Allow-Headers",
            "Content-Type"
        )

        self.send_header(
            "Content-Length",
            str(len(content))
        )

        self.end_headers()

        self.wfile.write(content)

    def do_OPTIONS(self):

        self.send_json({"ok": True})

    def do_GET(self):

        parsed = urllib.parse.urlparse(
            self.path
        )

        path = parsed.path

        params = urllib.parse.parse_qs(
            parsed.query
        )

        if path == "/":

            return self.send_json({
                "name": "KHELV DATA HISTORY BOT",
                "version": "3.0",
                "game": "WinGo 1 Minute",
                "status": "running",
                "endpoints": [
                    "/api/history",
                    "/api/latest",
                    "/health"
                ]
            })

        elif path == "/health":

            with db_lock:

                conn = db_connect()

                stats = conn.execute("""
                    SELECT
                        COUNT(*) AS total,
                        SUM(
                            CASE WHEN broadcasted = 1
                            THEN 1 ELSE 0 END
                        ) AS sent,
                        SUM(
                            CASE WHEN broadcasted = 0
                            THEN 1 ELSE 0 END
                        ) AS pending
                    FROM history
                """).fetchone()

                conn.close()

            return self.send_json({
                "status": "ok",
                "version": "3.0",
                "game": "WinGo 1M",
                "timestamp": int(time.time()),
                "total_records": stats["total"],
                "broadcasted": stats["sent"] or 0,
                "pending": stats["pending"] or 0
            })

        elif path == "/api/latest":

            records = get_history(1)

            return self.send_json(
                records[0] if records else None
            )

        elif path == "/api/history":

            limit = params.get(
                "limit",
                ["100"]
            )[0]

            try:

                limit = int(limit)

            except ValueError:

                limit = 100

            records = get_history(limit)

            records.reverse()

            return self.send_json(records)

        else:

            return self.send_json({
                "error": "Endpoint not found"
            }, 404)

    def log_message(self, format, *args):

        log.info(
            "HTTP: " + format % args
        )


# ================= START WEB SERVER =================

def start_web_server():

    server = ThreadingHTTPServer(
        ("0.0.0.0", PORT),
        WebsiteHandler
    )

    log.info(
        "Website API running on port %s",
        PORT
    )

    server.serve_forever()


