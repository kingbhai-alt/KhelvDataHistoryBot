db_lock = threading.RLock()

# ================= DATABASE =================

def db_connect():
    conn = sqlite3.connect(DB_PATH, timeout=30)
    conn.row_factory = sqlite3.Row
    return conn


def init_database():
    with db_lock:
        conn = db_connect()
        conn.execute("""
            CREATE TABLE IF NOT EXISTS history (
                period TEXT PRIMARY KEY,
                number INTEGER NOT NULL,
                big_small TEXT NOT NULL,
                color TEXT NOT NULL,
                broadcasted INTEGER DEFAULT 0,
                tg_message_id INTEGER,
                created_at TEXT DEFAULT CURRENT_TIMESTAMP
            )
        """)
        conn.execute("""
            CREATE TABLE IF NOT EXISTS tg_batches (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                message_id INTEGER NOT NULL,
                records_json TEXT NOT NULL,
                is_closed INTEGER DEFAULT 0,
                created_at TEXT DEFAULT CURRENT_TIMESTAMP
            )
        """)
        conn.commit()
        conn.close()
        log.info("SQLite database initialized")

# ================= RESULT PROCESSOR =================

def get_color(number):
    """
    Color mapping based on the supplied sample format.
    0 = Red + Violet
    5 = Green + Violet
    """
    mapping = {
        0: ["Red", "Violet"],
        1: ["Green"],
        2: ["Red"],
        3: ["Green"],
        4: ["Red"],
        5: ["Green", "Violet"],
        6: ["Red"],
        7: ["Green"],
        8: ["Red"],
        9: ["Green"]
    }
    return mapping[number]


def extract_api_list(data):
    if isinstance(data, dict):
        if isinstance(data.get("data"), dict):
            result = data["data"].get("list")
            if isinstance(result, list):
                return result
        if isinstance(data.get("data"), list):
            return data["data"]
        if isinstance(data.get("list"), list):
            return data["list"]
        if isinstance(data.get("result"), list):
            return data["result"]
    if isinstance(data, list):
        return data
    return []


def normalize_result(item):
    if not isinstance(item, dict):
        return None
    period = item.get("issueNumber") or item.get("issue") or item.get("period")
    number = item.get("number")
    if period is None or number is None:
        return None

    period = str(period).strip()
    try:
        number = int(number)
    except (ValueError, TypeError):
        return None

    if not period or number < 0 or number > 9:
        return None

    big_small = "Big" if number >= 5 else "Small"

    raw_color = item.get("color")
    if isinstance(raw_color, list) and raw_color:
        color = [str(x).strip().capitalize() for x in raw_color]
    elif isinstance(raw_color, str) and raw_color.strip():
        color = [x.strip().capitalize() for x in raw_color.replace(",", " ").split()]
    else:
        color = get_color(number)

    if not color or any(not x for x in color):
        return None

    return {
        "period": period,
        "number": number,
        "big_small": big_small,
        "color": color
    }

# ================= FETCH GAME API =================

def fetch_game_data():
    request = urllib.request.Request(API_URL, headers=HEADERS)
    with urllib.request.urlopen(request, timeout=15) as response:
        if response.status != 200:
            raise RuntimeError(f"Game API HTTP {response.status}")
        raw = response.read().decode("utf-8")
        data = json.loads(raw)

    raw_list = extract_api_list(data)
    results = []
    for item in raw_list:
        result = normalize_result(item)
        if result:
            results.append(result)
    return results

# ================= DATABASE OPERATIONS =================

def save_result(record, broadcasted=0):
    with db_lock:
        conn = db_connect()
        cursor = conn.execute("""
            INSERT OR IGNORE INTO history (period, number, big_small, color, broadcasted)
            VALUES (?, ?, ?, ?, ?)
        """, (
            record["period"],
            record["number"],
            record["big_small"],
            json.dumps(record["color"]),
            broadcasted
        ))
        inserted = cursor.rowcount == 1
        conn.commit()
        conn.close()
        return inserted


def database_is_empty():
    with db_lock:
        conn = db_connect()
        row = conn.execute("SELECT COUNT(*) AS total FROM history").fetchone()
        conn.close()
        return row["total"] == 0


def get_pending_results():
    with db_lock:
        conn = db_connect()
        rows = conn.execute("""
            SELECT period, number, big_small, color
            FROM history
            WHERE broadcasted = 0
            ORDER BY period ASC
        """).fetchall()
        conn.close()
        return [
            {
                "period": row["period"],
                "number": row["number"],
                "big_small": row["big_small"],
                "color": json.loads(row["color"])
            }
            for row in rows
        ]


def mark_broadcasted(period, tg_message_id):
    with db_lock:
        conn = db_connect()
        conn.execute("""
            UPDATE history
            SET broadcasted = 1, tg_message_id = ?
            WHERE period = ?
        """, (tg_message_id, period))
        conn.commit()
        conn.close()


def is_period_already_broadcasted(period):
    with db_lock:
        conn = db_connect()
        row = conn.execute(
            "SELECT broadcasted FROM history WHERE period = ?",
            (period,)
        ).fetchone()
        conn.close()
        return bool(row and row["broadcasted"] == 1)


def seed_initial_history(results):
    """First startup: Save current API history without broadcasting old results."""
    for record in results:
        save_result(record, broadcasted=1)
    log.info("Initial history saved: %s records", len(results))


def get_history(limit=100):
    limit = max(1, min(int(limit), MAX_HISTORY))
    with db_lock:
        conn = db_connect()
        rows = conn.execute("""
            SELECT period, number, big_small, color
            FROM history
            ORDER BY period DESC
            LIMIT ?
        """, (limit,)).fetchall()
        conn.close()
        return [
            {
                "period": row["period"],
                "number": row["number"],
                "big_small": row["big_small"],
                "color": json.loads(row["color"])
            }
            for row in rows
        ]


def get_active_batch():
    with db_lock:
        conn = db_connect()
        row = conn.execute("""
            SELECT id, message_id, records_json, is_closed
            FROM tg_batches
            WHERE is_closed = 0
            ORDER BY id DESC
            LIMIT 1
        """).fetchone()
        conn.close()
        if not row:
            return None
        return {
            "id": row["id"],
            "message_id": row["message_id"],
            "records": json.loads(row["records_json"]),
            "is_closed": row["is_closed"]
        }


def create_batch(message_id, records):
    with db_lock:
        conn = db_connect()
        cursor = conn.execute("""
            INSERT INTO tg_batches (message_id, records_json, is_closed)
            VALUES (?, ?, 0)
        """, (message_id, json.dumps(records, ensure_ascii=False)))
        batch_id = cursor.lastrowid
        conn.commit()
        conn.close()
        return batch_id


def update_batch_records(batch_id, records):
    with db_lock:
        conn = db_connect()
        conn.execute("""
            UPDATE tg_batches
            SET records_json = ?
            WHERE id = ?
        """, (json.dumps(records, ensure_ascii=False), batch_id))
        conn.commit()
        conn.close()


def close_batch(batch_id):
    with db_lock:
        conn = db_connect()
        conn.execute("""
            UPDATE tg_batches
            SET is_closed = 1
            WHERE id = ?
        """, (batch_id,))
        conn.commit()
        conn.close()

# ================= TELEGRAM FORMATTING =================

def format_row(rec):
    period = str(rec["period"])
    num = str(rec["number"])
    size = f"{rec['big_small']:<5}"
    colors = ", ".join(rec["color"]) if isinstance(rec["color"], list) else str(rec["color"])
    return f"{period} | {num} | {size} | {colors}"


def format_history_message(records_list):
    lines = [
        "WIN GO 1M | RESULT HISTORY",
        "Period            | Num | Size  | Color",
        "-----------------------------------------"
    ]
    for rec in records_list:
        lines.append(format_row(rec))
    lines.append("-----------------------------------------")
    lines.append(f"Total Entries: {len(records_list)}")
    body = "\n".join(lines)
    return "<pre>" + html.escape(body) + "</pre>"


def tg_api_call(method, payload):
    url = f"https://api.telegram.org/bot{BOT_TOKEN}/{method}"
    body = urllib.parse.urlencode(payload).encode("utf-8")
    request = urllib.request.Request(
        url,
        data=body,
        headers={"Content-Type": "application/x-www-form-urlencoded"},
        method="POST"
    )
    with urllib.request.urlopen(request, timeout=20) as response:
        return json.loads(response.read().decode("utf-8"))


def telegram_send_new_message(records_list):
    if not BOT_TOKEN:
        log.error("TELEGRAM_BOT_TOKEN is missing")
        return None

    # No reply_markup / buttons included
    payload = {
        "chat_id": CHANNEL_ID,
        "text": format_history_message(records_list),
        "parse_mode": "HTML"
    }
    try:
        result = tg_api_call("sendMessage", payload)
        if result.get("ok") is True and isinstance(result.get("result"), dict):
            msg_id = result["result"].get("message_id")
            log.info("Telegram new message sent (msg_id=%s, entries=%s)", msg_id, len(records_list))
            return msg_id
        log.error("Telegram sendMessage rejected: %s", result)
    except Exception as error:
        log.error("Telegram sendMessage error: %s", error)
    return None


def telegram_edit_message(message_id, records_list):
    if not BOT_TOKEN:
        log.error("TELEGRAM_BOT_TOKEN is missing")
        return False

    # No reply_markup / buttons included
    payload = {
        "chat_id": CHANNEL_ID,
        "message_id": message_id,
        "text": format_history_message(records_list),
        "parse_mode": "HTML"
    }
    try:
        result = tg_api_call("editMessageText", payload)
        if result.get("ok") is True:
            log.info("Telegram message updated (msg_id=%s, entries=%s)", message_id, len(records_list))
            return True
        desc = str(result.get("description", ""))
        if "message is not modified" in desc.lower():
            return True
        log.error("Telegram editMessageText rejected: %s", result)
    except Exception as error:
        log.error("Telegram editMessageText error: %s", error)
    return False

# ================= BROADCAST PROCESSOR =================

def append_record_to_telegram(record):
    """
    Appends unique record to active Telegram message while under MAX_TG_TEXT_LEN.
    Starts a fresh message once limit is reached so results never repeat.
    """
    active = get_active_batch()

    if active is None:
        new_records = [record]
        msg_id = telegram_send_new_message(new_records)
        if msg_id is None:
            return None
        create_batch(msg_id, new_records)
        return msg_id

    existing_periods = {str(r.get("period")) for r in active["records"]}
    if str(record["period"]) in existing_periods:
        log.info("Skipped duplicate period in active batch: %s", record["period"])
        return active["message_id"]

    candidate_records = active["records"] + [record]
    candidate_text = format_history_message(candidate_records)

    if len(candidate_text) <= MAX_TG_TEXT_LEN:
        ok = telegram_edit_message(active["message_id"], candidate_records)
        if not ok:
            return None
        update_batch_records(active["id"], candidate_records)
        return active["message_id"]

    close_batch(active["id"])
    new_records = [record]
    new_msg_id = telegram_send_new_message(new_records)
    if new_msg_id is None:
        return None
    create_batch(new_msg_id, new_records)
    log.info("Started fresh Telegram message (msg_id=%s) after character limit", new_msg_id)
    return new_msg_id


def process_pending():
    pending = get_pending_results()
    for record in pending:
        if is_period_already_broadcasted(record["period"]):
            continue
        msg_id = append_record_to_telegram(record)
        if msg_id is None:
            break
        mark_broadcasted(record["period"], msg_id)

# ================= DATA COLLECTOR =================

def collector_loop():
    initialized = not database_is_empty()
    while True:
        try:
            results = fetch_game_data()
            if not results:
                log.warning("API returned no valid results")
                time.sleep(POLL_INTERVAL)
                continue

            if not initialized:
                seed_initial_history(results)
                initialized = True
            else:
                for record in results:
                    save_result(record, broadcasted=0)
                process_pending()

            time.sleep(POLL_INTERVAL)
        except Exception as error:
            log.exception("Collector error: %s", error)
            time.sleep(max(POLL_INTERVAL, 3))

# ================= WEBSITE JSON API =================

class WebsiteHandler(BaseHTTPRequestHandler):
    def send_json(self, data, status=200):
        content = json.dumps(data, ensure_ascii=False, indent=2).encode("utf-8")
        self.send_response(status)
        self.send_header("Content-Type", "application/json; charset=utf-8")
        self.send_header("Access-Control-Allow-Origin", "*")
        self.send_header("Access-Control-Allow-Methods", "GET, OPTIONS")
        self.send_header("Access-Control-Allow-Headers", "Content-Type")
        self.send_header("Content-Length", str(len(content)))
        self.end_headers()
        self.wfile.write(content)

    def do_OPTIONS(self):
        self.send_json({"ok": True})

    def do_GET(self):
        parsed = urllib.parse.urlparse(self.path)
        path = parsed.path
        params = urllib.parse.parse_qs(parsed.query)

        if path == "/":
            return self.send_json({
                "name": "KHELV DATA HISTORY BOT",
                "game": "WinGo 1 Minute",
                "status": "running",
                "endpoints": ["/api/history", "/api/latest", "/health"]
            })
        elif path == "/health":
            return self.send_json({
                "status": "ok",
                "game": "WinGo 1M",
                "timestamp": int(time.time())
            })
        elif path == "/api/latest":
            records = get_history(1)
            return self.send_json(records[0] if records else None)
        elif path == "/api/history":
            limit = params.get("limit", ["100"])[0]
            try:
                limit = int(limit)
            except ValueError:
                limit = 100
            return self.send_json(get_history(limit))
        else:
            return self.send_json({"error": "Endpoint not found"}, 404)

    def log_message(self, format, *args):
        log.info("HTTP: " + format % args)

# ================= START WEB SERVER =================

def start_web_server():
    server = ThreadingHTTPServer(("0.0.0.0", PORT), WebsiteHandler)
    log.info("Website JSON API running on port %s", PORT)
    server.serve_forever()

# ================= MAIN =================

def main():
    if not BOT_TOKEN:
        raise SystemExit("ERROR: Set TELEGRAM_BOT_TOKEN environment variable")
    if not CHANNEL_ID:
        raise SystemExit("ERROR: Set TELEGRAM_CHAT_ID environment variable")

    init_database()
    web_thread = threading.Thread(target=start_web_server, daemon=True)
    web_thread.start()

    log.info("====================================")
    log.info("KHELV DATA HISTORY BOT V2.1")
    log.info("GAME: WinGo 1 Minute")
    log.info("PREDICTION: DISABLED")
    log.info("AI: DISABLED")
    log.info("====================================")

    try:
        collector_loop()
    except KeyboardInterrupt:
        log.info("Bot stopped by user")


if __name__ == "__main__":
    main()
