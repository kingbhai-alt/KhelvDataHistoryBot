"""
KHELV DATA HISTORY BOT (Fresh Scratch Build)
WinGo 1M | Rolling Telegram History Broadcaster
No Prediction | No AI | No JSON | No Buttons
"""

import os
import json
import time
import html
import sqlite3
import logging
import threading
import urllib.request
import urllib.parse
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

# ================= ENV CONFIG =================

BOT_TOKEN = os.getenv("TELEGRAM_BOT_TOKEN", "9110025108:AAHtWMpg6BkgQ5ri8abKG5C6m42cdulTJZA").strip()
CHAT_ID = os.getenv("TELEGRAM_CHAT_ID", "-1003811055440").strip()
API_URL = os.getenv(
    "API_URL",
    "https://draw.ar-lottery01.com/WinGo/WinGo_1M/GetHistoryIssuePage.json"
).strip()

POLL_INTERVAL = float(os.getenv("POLL_INTERVAL", "2"))
PORT = int(os.getenv("PORT", "8080"))
DB_FILE = os.getenv("DB_FILE", "wingo_history.db")
MAX_CHARS = int(os.getenv("MAX_CHARS", "3850"))
FRESH_START = os.getenv("FRESH_START", "0").strip().lower() in ("1", "true", "yes")

HEADERS = {
    "User-Agent": "Mozilla/5.0 (Linux; Android 10) AppleWebKit/537.36 Chrome/120 Safari/537.36",
    "Referer": "https://hgnice.biz",
    "Accept": "application/json"
}

logging.basicConfig(
    level=logging.INFO,
    format="%(asctime)s | %(levelname)s | %(message)s"
)
log = logging.getLogger("WINGO-BOT")

lock = threading.RLock()

# ================= DB LAYER =================

def get_conn():
    conn = sqlite3.connect(DB_FILE, timeout=30)
    conn.row_factory = sqlite3.Row
    return conn


def setup_db():
    with lock:
        if FRESH_START and os.path.exists(DB_FILE):
            os.remove(DB_FILE)
            log.warning("FRESH_START active: old DB removed (%s)", DB_FILE)

        conn = get_conn()
        conn.execute("""
            CREATE TABLE IF NOT EXISTS results (
                period TEXT PRIMARY KEY,
                number INTEGER NOT NULL,
                size TEXT NOT NULL,
                color TEXT NOT NULL,
                sent INTEGER DEFAULT 0
            )
        """)
        conn.execute("""
            CREATE TABLE IF NOT EXISTS active_msg (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                message_id INTEGER NOT NULL,
                items_json TEXT NOT NULL,
                closed INTEGER DEFAULT 0
            )
        """)
        conn.commit()
        conn.close()
        log.info("Database ready: %s", DB_FILE)

# ================= GAME DATA PARSER =================

def map_color(num):
    colors = {
        0: ["Red", "Violet"],
        1: ["Green"],
        2: ["Red"],
        3: ["Green"],
        4: ["Red"],
        5: ["Green", "Violet"],
        6: ["Red"],
        7: ["Green"],
        8: ["Red"],
        9: ["Green"]
    }
    return colors[num]


def pull_raw_list(payload):
    if isinstance(payload, dict):
        if isinstance(payload.get("data"), dict) and isinstance(payload["data"].get("list"), list):
            return payload["data"]["list"]
        if isinstance(payload.get("data"), list):
            return payload["data"]
        if isinstance(payload.get("list"), list):
            return payload["list"]
        if isinstance(payload.get("result"), list):
            return payload["result"]
    if isinstance(payload, list):
        return payload
    return []


def clean_row(raw):
    if not isinstance(raw, dict):
        return None
    period = raw.get("issueNumber") or raw.get("issue") or raw.get("period")
    number = raw.get("number")
    if period is None or number is None:
        return None

    period = str(period).strip()
    try:
        number = int(number)
    except (ValueError, TypeError):
        return None

    if not period or number < 0 or number > 9:
        return None

    size = "Big" if number >= 5 else "Small"

    raw_color = raw.get("color")
    if isinstance(raw_color, list) and raw_color:
        color = [str(c).strip().capitalize() for c in raw_color if str(c).strip()]
    elif isinstance(raw_color, str) and raw_color.strip():
        color = [c.strip().capitalize() for c in raw_color.replace(",", " ").split() if c.strip()]
    else:
        color = map_color(number)

    if not color:
        return None

    return {
        "period": period,
        "number": number,
        "size": size,
        "color": color
    }


def fetch_results():
    req = urllib.request.Request(API_URL, headers=HEADERS)
    with urllib.request.urlopen(req, timeout=15) as resp:
        if resp.status != 200:
            raise RuntimeError(f"HTTP {resp.status}")
        data = json.loads(resp.read().decode("utf-8"))

    out = []
    for item in pull_raw_list(data):
        parsed = clean_row(item)
        if parsed:
            out.append(parsed)
    return out

# ================= DB QUERIES =================

def has_any_data():
    with lock:
        conn = get_conn()
        cnt = conn.execute("SELECT COUNT(*) AS c FROM results").fetchone()["c"]
        conn.close()
        return cnt > 0


def insert_result(row, sent=0):
    with lock:
        conn = get_conn()
        conn.execute("""
            INSERT OR IGNORE INTO results (period, number, size, color, sent)
            VALUES (?, ?, ?, ?, ?)
        """, (row["period"], row["number"], row["size"], json.dumps(row["color"]), sent))
        conn.commit()
        conn.close()


def seed_old_results(rows):
    for r in rows:
        insert_result(r, sent=1)
    log.info("Seeded initial %s history rows without broadcasting", len(rows))


def get_unsent():
    with lock:
        conn = get_conn()
        rows = conn.execute("""
            SELECT period, number, size, color
            FROM results
            WHERE sent = 0
            ORDER BY period ASC
        """).fetchall()
        conn.close()
        return [
            {
                "period": x["period"],
                "number": x["number"],
                "size": x["size"],
                "color": json.loads(x["color"])
            }
            for x in rows
        ]


def mark_sent(period):
    with lock:
        conn = get_conn()
        conn.execute("UPDATE results SET sent = 1 WHERE period = ?", (period,))
        conn.commit()
        conn.close()


def get_latest_list(limit=100):
    limit = max(1, min(int(limit), 5000))
    with lock:
        conn = get_conn()
        rows = conn.execute("""
            SELECT period, number, size, color
            FROM results
            ORDER BY period DESC
            LIMIT ?
        """, (limit,)).fetchall()
        conn.close()
        return [
            {
                "period": x["period"],
                "number": x["number"],
                "size": x["size"],
                "color": json.loads(x["color"])
            }
            for x in rows
        ]


def get_open_batch():
    with lock:
        conn = get_conn()
        row = conn.execute("""
            SELECT id, message_id, items_json
            FROM active_msg
            WHERE closed = 0
            ORDER BY id DESC
            LIMIT 1
        """).fetchone()
        conn.close()
        if not row:
            return None
        return {
            "id": row["id"],
            "message_id": row["message_id"],
            "items": json.loads(row["items_json"])
        }


def save_new_batch(message_id, items):
    with lock:
        conn = get_conn()
        cur = conn.execute("""
            INSERT INTO active_msg (message_id, items_json, closed)
            VALUES (?, ?, 0)
        """, (message_id, json.dumps(items, ensure_ascii=False)))
        bid = cur.lastrowid
        conn.commit()
        conn.close()
        return bid


def save_batch_items(batch_id, items):
    with lock:
        conn = get_conn()
        conn.execute(
            "UPDATE active_msg SET items_json = ? WHERE id = ?",
            (json.dumps(items, ensure_ascii=False), batch_id)
        )
        conn.commit()
        conn.close()


def close_old_batch(batch_id):
    with lock:
        conn = get_conn()
        conn.execute("UPDATE active_msg SET closed = 1 WHERE id = ?", (batch_id,))
        conn.commit()
        conn.close()

# ================= TELEGRAM BROADCASTER =================

def build_text(items):
    lines = ["<b>WIN GO 1M HISTORY</b>", ""]
    for idx, item in enumerate(items, start=1):
        p = html.escape(str(item["period"]))
        n = html.escape(str(item["number"]))
        s = html.escape(str(item["size"]))
        c = html.escape(", ".join(item["color"]))
        lines.append(f"{idx}. Period: <b>{p}</b>")
        lines.append(f"   Num: <b>{n}</b> | Size: <b>{s}</b> | Color: <b>{c}</b>")
    lines.append("")
    lines.append(f"Total: <b>{len(items)}</b>")
    return "\n".join(lines)


def call_tg(method, data):
    url = f"https://api.telegram.org/bot{BOT_TOKEN}/{method}"
    encoded = urllib.parse.urlencode(data).encode("utf-8")
    req = urllib.request.Request(
        url,
        data=encoded,
        headers={"Content-Type": "application/x-www-form-urlencoded"},
        method="POST"
    )
    with urllib.request.urlopen(req, timeout=20) as resp:
        return json.loads(resp.read().decode("utf-8"))


def send_tg_message(items):
    payload = {
        "chat_id": CHAT_ID,
        "text": build_text(items),
        "parse_mode": "HTML"
    }
    res = call_tg("sendMessage", payload)
    if res.get("ok") and isinstance(res.get("result"), dict):
        return res["result"].get("message_id")
    log.error("sendMessage failed: %s", res)
    return None


def edit_tg_message(message_id, items):
    payload = {
        "chat_id": CHAT_ID,
        "message_id": message_id,
        "text": build_text(items),
        "parse_mode": "HTML"
    }
    res = call_tg("editMessageText", payload)
    if res.get("ok"):
        return True
    if "message is not modified" in str(res.get("description", "")).lower():
        return True
    log.error("editMessageText failed: %s", res)
    return False


def push_record(record):
    batch = get_open_batch()

    if batch is None:
        items = [record]
        msg_id = send_tg_message(items)
        if not msg_id:
            return False
        save_new_batch(msg_id, items)
        return True

    seen = {str(x.get("period")) for x in batch["items"]}
    if str(record["period"]) in seen:
        return True

    updated_items = batch["items"] + [record]
    if len(build_text(updated_items)) <= MAX_CHARS:
        if not edit_tg_message(batch["message_id"], updated_items):
            return False
        save_batch_items(batch["id"], updated_items)
        return True

    close_old_batch(batch["id"])
    fresh_items = [record]
    new_msg_id = send_tg_message(fresh_items)
    if not new_msg_id:
        return False
    save_new_batch(new_msg_id, fresh_items)
    return True


def flush_unsent():
    for row in get_unsent():
        if push_record(row):
            mark_sent(row["period"])
        else:
            break

# ================= LOOP & HTTP SERVER =================

def run_loop():
    ready = has_any_data()
    while True:
        try:
            rows = fetch_results()
            if rows:
                if not ready:
                    seed_old_results(rows)
                    ready = True
                else:
                    for r in rows:
                        insert_result(r, sent=0)
                    flush_unsent()
            time.sleep(POLL_INTERVAL)
        except Exception as err:
            log.exception("Loop error: %s", err)
            time.sleep(max(POLL_INTERVAL, 3))


class Handler(BaseHTTPRequestHandler):
    def json_resp(self, obj, code=200):
        body = json.dumps(obj, ensure_ascii=False, indent=2).encode("utf-8")
        self.send_response(code)
        self.send_header("Content-Type", "application/json; charset=utf-8")
        self.send_header("Access-Control-Allow-Origin", "*")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def do_GET(self):
        parsed = urllib.parse.urlparse(self.path)
        qs = urllib.parse.parse_qs(parsed.query)
        if parsed.path == "/health":
            self.json_resp({"ok": True, "ts": int(time.time())})
        elif parsed.path == "/api/latest":
            data = get_latest_list(1)
            self.json_resp(data[0] if data else None)
        elif parsed.path == "/api/history":
            lim = qs.get("limit", ["100"])[0]
            try:
                lim = int(lim)
            except ValueError:
                lim = 100
            self.json_resp(get_latest_list(lim))
        else:
            self.json_resp({"status": "running"})

    def log_message(self, fmt, *args):
        log.info("HTTP: " + fmt % args)


def start_http():
    srv = ThreadingHTTPServer(("0.0.0.0", PORT), Handler)
    log.info("HTTP server listening on :%s", PORT)
    srv.serve_forever()


def main():
    if not BOT_TOKEN:
        raise SystemExit("Missing TELEGRAM_BOT_TOKEN")
    if not CHAT_ID:
        raise SystemExit("Missing TELEGRAM_CHAT_ID")

    setup_db()
    threading.Thread(target=start_http, daemon=True).start()
    log.info("WinGo 1M History Bot started")
    run_loop()


if __name__ == "__main__":
    main()
